@model IEnumerable<StudentCourseManagement.Models.Enrollment>

@{
    var course = (StudentCourseManagement.Models.Course)ViewBag.Course;
    ViewData["Title"] = $"Class Roster - {course.CourseName}";
}

<!-- Course Header Card -->
<div class="card-modern mb-4">
    <div class="p-4 bg-light-subtle border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <span class="stat-icon-box stat-icon-primary" style="width: 52px; height: 52px; font-size: 1.6rem;">
                <i class="bi bi-mortarboard-fill"></i>
            </span>
            <div>
                <span class="badge-soft-primary mb-1">
                    <i class="bi bi-book"></i> Course Roster
                </span>
                <h3 class="fw-bold mb-0">@course.CourseName</h3>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Enrollments" asp-action="Create" asp-route-courseId="@course.Id" class="btn-app-primary">
                <i class="bi bi-person-plus-fill"></i>
                <span>Enroll Student</span>
            </a>
            <a asp-action="Index" class="btn-app-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Courses</span>
            </a>
        </div>
    </div>

    <div class="p-4">
        <div class="row g-3">
            <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3">
                    <div class="text-muted small text-uppercase fw-semibold">Tuition Fees</div>
                    <div class="fs-4 fw-bold text-dark mt-1">₹@course.Fees.ToString("N2")</div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3">
                    <div class="text-muted small text-uppercase fw-semibold">Duration</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@course.DurationInWeeks Weeks</div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3">
                    <div class="text-muted small text-uppercase fw-semibold">Enrolled Students</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@Model.Count()</div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3">
                    <div class="text-muted small text-uppercase fw-semibold">Course ID</div>
                    <div class="fs-4 fw-bold text-secondary mt-1">#@course.Id</div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(course.Description))
        {
            <div class="mt-3 p-3 bg-white border rounded-3 small text-muted">
                <strong>Course Syllabus:</strong> @course.Description
            </div>
        }
    </div>
</div>

<!-- Notification Alert -->
@if (TempData["Success"] != null)
{
    <div class="app-alert app-alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div class="flex-grow-1">@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Enrolled Students Table -->
<div class="app-table-container">
    <div class="card-modern-header">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-people-fill text-primary fs-5"></i>
            <h5 class="fw-bold mb-0">Enrolled Students Directory</h5>
        </div>
        <span class="badge-soft-slate">Total Enrolled: @Model.Count()</span>
    </div>

    <div class="table-responsive">
        <table class="app-table align-middle">
            <thead>
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Student Name</th>
                    <th>Contact Details</th>
                    <th>Department</th>
                    <th>Enrollment Date</th>
                    <th>Current Status / Grade</th>
                    <th class="text-end" style="width: 220px;">Faculty Grade / Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrollment in Model)
                {
                    var student = enrollment.Student;
                    var initials = "";
                    if (!string.IsNullOrWhiteSpace(student?.FullName))
                    {
                        var parts = student.FullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        if (parts.Length >= 2)
                        {
                            initials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
                        }
                        else if (parts.Length == 1 && parts[0].Length > 0)
                        {
                            initials = parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
                        }
                    }
                    if (string.IsNullOrEmpty(initials)) initials = "ST";

                    <tr>
                        <td class="text-muted fw-semibold">#@enrollment.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <span class="student-avatar">@initials</span>
                                <div>
                                    <div class="fw-bold text-dark">@(student?.FullName ?? "Unknown")</div>
                                    <small class="text-muted">ID: #@(student?.Id ?? 0)</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small">
                                <a href="mailto:@(student?.Email)" class="text-muted text-decoration-none d-flex align-items-center gap-1">
                                    <i class="bi bi-envelope text-primary"></i> @(student?.Email ?? "N/A")
                                </a>
                                @if (!string.IsNullOrWhiteSpace(student?.Phone))
                                {
                                    <div class="text-muted d-flex align-items-center gap-1 mt-1">
                                        <i class="bi bi-telephone text-secondary"></i> @student.Phone
                                    </div>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="badge-soft-slate">
                                <i class="bi bi-building"></i>
                                <span>@(string.IsNullOrWhiteSpace(student?.Department) ? "General" : student.Department)</span>
                            </span>
                        </td>
                        <td>
                            <span class="text-muted small d-inline-flex align-items-center gap-1">
                                <i class="bi bi-calendar-check text-secondary"></i>
                                <span>@enrollment.EnrollmentDate.ToString("dd MMM yyyy")</span>
                            </span>
                        </td>
                        <td>
                            @if (enrollment.Status.Contains("Grade: A") || enrollment.Status == "Completed")
                            {
                                <span class="badge-soft-success">
                                    <span class="badge-dot badge-dot-success"></span>
                                    <span>@enrollment.Status</span>
                                </span>
                            }
                            else if (enrollment.Status.Contains("Grade: B") || enrollment.Status == "Active")
                            {
                                <span class="badge-soft-primary">
                                    <span class="badge-dot badge-dot-primary"></span>
                                    <span>@enrollment.Status</span>
                                </span>
                            }
                            else
                            {
                                <span class="badge-soft-warning">
                                    <span>@enrollment.Status</span>
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-controller="Enrollments"
                                  asp-action="UpdateStatus"
                                  method="post"
                                  class="d-inline-flex align-items-center gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@enrollment.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                                <select name="status" class="form-select form-select-sm py-1" style="font-size: 0.8rem; width: 140px;">
                                    <option value="Active" selected="@(enrollment.Status == "Active")">Active</option>
                                    <option value="In Progress" selected="@(enrollment.Status == "In Progress")">In Progress</option>
                                    <option value="Grade: A" selected="@(enrollment.Status == "Grade: A")">Grade: A</option>
                                    <option value="Grade: B" selected="@(enrollment.Status == "Grade: B")">Grade: B</option>
                                    <option value="Completed" selected="@(enrollment.Status == "Completed")">Completed</option>
                                </select>

                                <button type="submit" class="btn btn-sm btn-outline-primary py-1 px-2" title="Save Grade/Status">
                                    <i class="bi bi-check2"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="p-0">
                            <div class="app-empty-state">
                                <div class="app-empty-icon">
                                    <i class="bi bi-people"></i>
                                </div>
                                <h5 class="fw-bold mb-1">No Students Enrolled Yet</h5>
                                <p class="text-muted mb-3">There are currently no students registered for @course.CourseName.</p>
                                <a asp-controller="Enrollments" asp-action="Create" asp-route-courseId="@course.Id" class="btn-app-primary">
                                    <i class="bi bi-person-plus-fill"></i> Enroll First Student
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
