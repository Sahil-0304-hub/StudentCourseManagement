@model StudentCourseManagement.Models.Course

@{
    ViewData["Title"] = "Add Course";
}

<div class="form-card">
    <div class="form-card-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div class="stat-icon-box stat-icon-success">
                <i class="bi bi-journal-plus"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0">Add New Course</h4>
                <small class="text-muted">Enter curriculum details and fee structure</small>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="form-card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

            <div class="mb-3">
                <label asp-for="CourseName" class="form-label">Course Name <span class="text-danger">*</span></label>
                <div class="input-icon-group">
                    <i class="bi bi-book"></i>
                    <input asp-for="CourseName" class="form-control" placeholder="e.g. Full-Stack Web Development with .NET" />
                </div>
                <span asp-validation-for="CourseName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Course Description / Syllabus</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief outline of syllabus, modules, and prerequisites..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Fees" class="form-label">Tuition Fees (₹) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold text-muted">₹</span>
                        <input asp-for="Fees" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Fees" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DurationInWeeks" class="form-label">Duration (Weeks) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input asp-for="DurationInWeeks" type="number" min="1" class="form-control" placeholder="12" />
                        <span class="input-group-text bg-light text-muted">Weeks</span>
                    </div>
                    <span asp-validation-for="DurationInWeeks" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 pt-2 border-top">
                <button type="submit" class="btn-app-success">
                    <i class="bi bi-check2-circle"></i>
                    <span>Save Course</span>
                </button>
                <a asp-action="Index" class="btn-app-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
