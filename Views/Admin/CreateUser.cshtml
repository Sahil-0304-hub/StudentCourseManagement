@model StudentCourseManagement.Controllers.CreateUserViewModel

@{
    ViewData["Title"] = "Create User Account";
}

<div class="form-card">
    <div class="form-card-header d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div class="stat-icon-box stat-icon-primary">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-0">Create User Account</h4>
                <small class="text-muted">Register an Administrator or Faculty member</small>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left"></i> Manage Users
        </a>
    </div>

    <div class="form-card-body">
        @if (TempData["Success"] != null)
        {
            <div class="app-alert app-alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div class="flex-grow-1">@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-controller="Admin" asp-action="CreateUser" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label">Account Role <span class="text-danger">*</span></label>
                <div class="input-icon-group">
                    <i class="bi bi-shield-check"></i>
                    <select asp-for="Role" class="form-select ps-5">
                        <option value="Student">Student (Course Enrollee)</option>
                        <option value="Faculty">Faculty (Teaching & Course Staff)</option>
                        <option value="Admin">Administrator (Full System Access)</option>
                    </select>
                </div>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                <div class="input-icon-group">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="user@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                <div class="input-icon-group">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Create a strong password" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                <div class="input-icon-group">
                    <i class="bi bi-shield-lock"></i>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="alert alert-info py-2 small d-flex align-items-center gap-2 mb-4">
                <i class="bi bi-info-circle-fill text-info"></i>
                <span>Password must be at least 8 characters and include uppercase, lowercase, numbers, and symbols.</span>
            </div>

            <div class="d-flex align-items-center gap-2 pt-2 border-top">
                <button type="submit" class="btn-app-primary">
                    <i class="bi bi-person-check-fill"></i>
                    <span>Create Account</span>
                </button>
                <a asp-action="Index" class="btn-app-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}