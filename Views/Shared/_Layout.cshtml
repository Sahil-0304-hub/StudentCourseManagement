<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Course Management</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Custom Modern Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudentCourseManagement.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container-fluid px-lg-4">

                <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>
                    <span>EduPortal</span>
                </a>

                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">

                        <li class="nav-item">
                            <a class="nav-link app-nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-grid-1x2"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>

                        @if (User.IsInRole("Admin") || User.IsInRole("Faculty"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link"
                                   asp-controller="Students"
                                   asp-action="Index">
                                    <i class="bi bi-people"></i>
                                    <span>Students</span>
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link app-nav-link"
                               asp-controller="Courses"
                               asp-action="Index">
                                <i class="bi bi-book"></i>
                                <span>@(User.IsInRole("Student") ? "Browse Courses" : "Courses")</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link app-nav-link"
                               asp-controller="Enrollments"
                               asp-action="Index">
                                <i class="bi bi-card-checklist"></i>
                                <span>@(User.IsInRole("Student") ? "My Enrollments" : "Enrollments")</span>
                            </a>
                        </li>

                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link"
                                   asp-controller="Students"
                                   asp-action="MyProfile">
                                    <i class="bi bi-person-badge"></i>
                                    <span>My Profile</span>
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">
                                    <i class="bi bi-people-gear"></i>
                                    <span>Manage Users</span>
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var initial = !string.IsNullOrEmpty(User.Identity.Name)
                                ? User.Identity.Name.Substring(0, 1).ToUpper()
                                : "U";

                            <li class="nav-item">
                                <div class="user-badge-pill">
                                    <span class="user-avatar-circle">@initial</span>
                                    <span>@User.Identity.Name</span>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill py-0 px-2" style="font-size: 0.72rem;">Admin</span>
                                    }
                                    else if (User.IsInRole("Faculty"))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill py-0 px-2" style="font-size: 0.72rem;">Faculty</span>
                                    }
                                    else if (User.IsInRole("Student"))
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill py-0 px-2" style="font-size: 0.72rem;">Student</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill py-0 px-2" style="font-size: 0.72rem;">User</span>
                                    }
                                </div>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm d-flex align-items-center gap-1 rounded-3 px-3 py-1">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Logout</span>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm d-flex align-items-center gap-1 rounded-3 px-3 py-1"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-lock"></i>
                                    <span>Sign In</span>
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content-wrapper">
        <div class="container-fluid px-lg-4 mt-4 mb-5">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="app-footer">
        <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge-dot badge-dot-success"></span>
                <span class="text-secondary small">&copy; @DateTime.Now.Year EduPortal Student Course Management</span>
            </div>
            <div class="text-muted small d-flex align-items-center gap-3">
                <a asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy Policy</a>
                <span>•</span>
                <span class="text-secondary">v1.0.0</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>