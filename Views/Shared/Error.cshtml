@model ErrorViewModel
@{
    ViewData["Title"] = "Application Error";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-7 col-lg-6">
        <div class="card-modern shadow-sm text-center p-4">
            <div class="app-empty-icon mx-auto mb-3" style="background: #fee2e2; color: #dc2626;">
                <i class="bi bi-exclamation-octagon-fill"></i>
            </div>
            <h3 class="fw-bold text-danger mb-2">Unexpected Error</h3>
            <p class="text-muted mb-4">
                An unexpected condition was encountered while processing your request. Please try again.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="p-2 mb-4 bg-light rounded-3 font-monospace small text-muted">
                    <span>Incident Reference: <code>@Model.RequestId</code></span>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn-app-primary">
                    <i class="bi bi-house-door"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
