@model StudentCourseManagement.Controllers.LoginViewModel

@{
    ViewData["Title"] = "Portal Sign In";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-7 col-lg-6 col-xl-5">
        <div class="card-modern shadow-lg">
            <div class="p-4 text-center border-bottom bg-light-subtle">
                <div class="app-brand-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.6rem; border-radius: 14px;">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <h4 class="fw-bold mb-1">Welcome to EduPortal</h4>
                <p class="text-muted small mb-0">Sign in with your Admin, Faculty, or Student credentials</p>
            </div>

            <!-- Demo Quick Login Buttons -->
            <div class="p-3 bg-light border-bottom">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-bold text-secondary text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Demo Fill
                    </span>
                    <span class="small text-muted" style="font-size: 0.72rem;">Click to auto-fill</span>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary rounded-pill flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1 py-1"
                            onclick="fillCredentials('admin@student.com', 'Admin@123')">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>Admin</span>
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-outline-success rounded-pill flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1 py-1"
                            onclick="fillCredentials('faculty@student.com', 'Faculty@123')">
                        <i class="bi bi-person-badge-fill"></i>
                        <span>Faculty</span>
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-outline-warning text-dark rounded-pill flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1 py-1"
                            onclick="fillCredentials('student@student.com', 'Student@123')">
                        <i class="bi bi-mortarboard-fill"></i>
                        <span>Student</span>
                    </button>
                </div>
            </div>

            <div class="p-4">
                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <div class="input-icon-group">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Email" id="emailInput" class="form-control" placeholder="user@student.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-icon-group">
                            <i class="bi bi-lock"></i>
                            <input asp-for="Password" id="passwordInput" type="password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted" for="rememberMeCheck">
                            Remember this device
                        </label>
                    </div>

                    <button type="submit" class="btn-app-primary w-100 justify-content-center py-2 fs-6">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Sign In to Portal</span>
                    </button>
                </form>
            </div>

            <!-- Credentials Reference Table -->
            <div class="px-4 pb-4">
                <div class="p-3 rounded-3 bg-light border small">
                    <div class="fw-bold text-dark mb-2 d-flex align-items-center gap-1">
                        <i class="bi bi-key-fill text-primary"></i> Default Login Credentials:
                    </div>
                    <div class="d-flex flex-column gap-1 text-muted" style="font-size: 0.8rem;">
                        <div>🛡️ <strong>Admin:</strong> <code>admin@student.com</code> / <code>Admin@123</code></div>
                        <div>👨‍🏫 <strong>Faculty:</strong> <code>faculty@student.com</code> / <code>Faculty@123</code></div>
                        <div>🎓 <strong>Student:</strong> <code>student@student.com</code> / <code>Student@123</code></div>
                    </div>
                </div>
            </div>

            <div class="p-3 bg-light text-center border-top">
                <small class="text-muted">
                    <i class="bi bi-shield-lock-fill me-1 text-primary"></i> Role-based access for Admin, Faculty, and Student
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function fillCredentials(email, password) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = password;
        }
    </script>
}